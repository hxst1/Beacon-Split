{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities granted to the main Beacon window. Kept to the minimum the app actually uses. Notifications are not here: they go through Beacon's own commands, which reach UserNotifications.framework directly.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-title",
    "core:window:allow-set-theme",
    "dialog:allow-open",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "core:window:allow-is-focused",
    "core:window:allow-destroy",
    "updater:default",
    "process:allow-restart",
    "opener:allow-open-path",
    "opener:allow-reveal-item-in-dir"
  ]
}
