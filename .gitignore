# Without the slash as well: a trailing slash matches only a directory, and a
# `node_modules` that is a symlink slipped past it straight into a commit —
# where it pointed at an absolute path on one machine and dangled on every
# other, including CI.
node_modules
node_modules/
dist/
target/
.DS_Store
*.log
.vite/
src-tauri/gen/schemas/
src-tauri/binaries/

# Written at deploy time by site/set-origin.sh, which needs a domain to exist.
site/sitemap.xml
